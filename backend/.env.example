# ===== DATABASE (Neon Postgres) =====
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ===== AUTH =====
JWT_SECRET=change-me-to-a-random-string-min-32-chars

# ===== PAYMENTS (Razorpay) =====
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_key_secret
# Webhook secret configured in the Razorpay dashboard (payment.captured + payment.failed)
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ===== IMAGE UPLOADS (Cloudinary) =====
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ===== SMS OTP (Twilio or MSG91 — optional in dev; OTP is logged to console) =====
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
MSG91_API_KEY=

# ===== SITE =====
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx

# ===== SCHEDULED JOBS (cron) =====
# Protects /api/cron (subscription cycles + T-24h booking reminders).
# Call: GET /api/cron?secret=... — without this, the endpoint is disabled.
CRON_SECRET=generate_a_long_random_string
