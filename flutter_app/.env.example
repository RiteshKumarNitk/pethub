# PawStore Flutter App Configuration Template
# Base API URL (e.g., http://10.0.2.2:3000 for Android emulator, http://localhost:3000 for iOS simulator, or production backend URL)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Razorpay Test Key (Client-side key ID)
RAZORPAY_KEY_ID=rzp_test_your_key_id

# Cloudinary Upload Config (For direct image uploads using an unsigned upload preset)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_UPLOAD_PRESET=pawstore_uploads